{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "go build -o server ./cmd/server"
  },
  "deploy": {
    "startCommand": "./server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "nixpacks": {
    "goVersion": "1.25"
  }
}
